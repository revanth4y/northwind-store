# Backend API (Express). Default matches backend PORT=3001.
VITE_API_URL=http://localhost:3001

# Same publishable key as backend CLERK_PUBLISHABLE_KEY (pk_test_... / pk_live_...).
# Must match backend CLERK_PUBLISHABLE_KEY.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Optional: omit VITE_SENTRY_DSN unless you have a real DSN (empty string can misconfigure Sentry).
# VITE_SENTRY_DSN=
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
